# VIT работает без единого ключа: на локальной модели (Ollama).
# Облачные модели подключаются по желанию — здесь или в приложении: Настройки → Модели.

# VIT_PORT=5313
# VIT_DATA=./data

# Локальная модель (Ollama)
# OLLAMA_URL=http://127.0.0.1:11434
# VIT_LOCAL_MODEL=qwen3:4b-instruct

# Облако (любой набор)
# ANTHROPIC_API_KEY=
# COMETAPI_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Голос: модель whisper.cpp (ggml-*.bin). Без неё работает ввод текстом.
# VIT_WHISPER_MODEL=

# Заявки команде в Telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Приложения с GitHub: без токена GitHub даёт 60 запросов в час, с токеном — 5000 (необязательно)
# GITHUB_TOKEN=
